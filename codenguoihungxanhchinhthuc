  <script src="/_sdk/22383239e6d7279e.editing_sdk.js" integrity="sha512-qvtUeUgPbBuWkcjob5tx6AGU1PQHkx4zgZWqqpaXOQqF0FGg35lPkDg2Eh+f2u6Np/H74EENvDhGRPcQgwZA+Q=="></script>
  <script>
    const screens = document.querySelectorAll('.screen');
    const items = [...document.querySelectorAll('.game-item')];
    const bins = [...document.querySelectorAll('.bin')];
    let playOrder = [...items];
    let playerName = '', score = 0, lives = 3, currentIndex = 0, timeLeft = 90, timer = null, acceptingDrop = true;
    let soundOn = true, audioCtx = null, musicTimer = null;

    function showScreen(id) {
      screens.forEach(s => s.classList.toggle('active', s.id === id));
      if (id !== 'game-screen') stopTimer();
    }
    function clickSound() { tone(530, .07, 'sine', .035); }
    function tone(freq, duration, type='sine', volume=.05) {
      if (!soundOn) return;
      try {
        audioCtx ||= new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
        osc.type = type; osc.frequency.value = freq; gain.gain.setValueAtTime(volume, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(.001, audioCtx.currentTime + duration);
        osc.connect(gain).connect(audioCtx.destination); osc.start(); osc.stop(audioCtx.currentTime + duration);
      } catch(e) {}
    }
    function correctSound(){ [523,659,784].forEach((n,i)=>setTimeout(()=>tone(n,.15,'triangle',.06),i*105)); }
    function wrongSound(){ tone(180,.24,'sawtooth',.05); setTimeout(()=>tone(130,.28,'sawtooth',.04),120); }
    function startMusic() {
      stopMusic(); if(!soundOn) return;
      let notes=[262,330,392,330,294,349,440,349], n=0;
      musicTimer=setInterval(()=>{ tone(notes[n++%notes.length],.16,'sine',.018); },420);
    }
    function stopMusic(){ if(musicTimer) clearInterval(musicTimer); musicTimer=null; }
    function toggleSound() {
      soundOn=!soundOn;
      ['sound-home','sound-game'].forEach(id=>{ const b=document.getElementById(id); if(b) b.textContent=soundOn?'🔊 ÂM THANH BẬT':'🔇 ÂM THANH TẮT'; });
      if(soundOn && document.getElementById('game-screen').classList.contains('active')) startMusic(); else if(!soundOn) stopMusic();
      if(soundOn) clickSound();
    }
    function updateStats() {
      document.getElementById('stat-name').textContent=playerName;
      document.getElementById('stat-score').textContent=String(score).padStart(3,'0');
      document.getElementById('stat-lives').textContent='❤️'.repeat(lives) || '0';
      document.getElementById('stat-count').textContent=`${currentIndex}/10`;
      document.getElementById('stat-time').textContent=`${timeLeft} giây`;
      const fill=document.getElementById('timer-fill'); fill.style.width=`${(timeLeft/90)*100}%`; fill.classList.toggle('urgent',timeLeft<=20);
    }
    function startTimer() {
      stopTimer(); timer=setInterval(()=>{ timeLeft--; updateStats(); if(timeLeft<=0) endGame('time'); },1000);
    }
    function stopTimer(){ if(timer) clearInterval(timer); timer=null; }
    function showItem() {
      items.forEach(item=>item.classList.remove('current'));
      playOrder[currentIndex].classList.add('current');
      acceptingDrop=true; document.getElementById('guide-text').textContent='Kéo vật rác vào đúng thùng nhé!';
      updateStats();
    }
    function startGame() {
      score=0;lives=3;currentIndex=0;timeLeft=90;acceptingDrop=true;
      playOrder=[...items].sort(()=>Math.random()-.5);
      showScreen('game-screen');showItem();startTimer();startMusic();tone(440,.16,'triangle',.06);setTimeout(()=>tone(660,.2,'triangle',.06),150);
    }
    function feedback(ok) {
      const box=document.getElementById('feedback');
      document.getElementById('feedback-title').textContent=ok?'🎉 CHÍNH XÁC!':'❌ CHƯA ĐÚNG!';
      document.getElementById('feedback-title').style.color=ok?'#229157':'#d34242';
      document.getElementById('feedback-points').textContent=ok?'+10 ĐIỂM':'-5 ĐIỂM';
      box.classList.remove('show'); void box.offsetWidth; box.classList.add('show');
    }
    function sparkle() {
      const zone=document.querySelector('.item-zone');
      for(let i=0;i<12;i++){let s=document.createElement('span');s.className='spark';s.textContent=i%2?'✨':'⭐';s.style.left='50%';s.style.top='45%';s.style.setProperty('--x',`${(Math.random()-.5)*330}px`);s.style.setProperty('--y',`${(Math.random()-.5)*230}px`);zone.appendChild(s);setTimeout(()=>s.remove(),950);}
    }
    function handleDrop(category, bin) {
      if(!acceptingDrop) return;
      const item=playOrder[currentIndex], correct=item.dataset.category===category;
      acceptingDrop=false;
      if(correct) {
        score+=10; feedback(true); correctSound(); sparkle(); bin.classList.add('active-drop');
        document.getElementById('guide-text').textContent='Giỏi lắm! Em đã phân loại đúng!';
        item.querySelector('.trash-item').style.transform='scale(.25) translateY(330px)'; item.querySelector('.trash-item').style.opacity='0';
        setTimeout(()=>{bin.classList.remove('active-drop');item.querySelector('.trash-item').style.transform='';item.querySelector('.trash-item').style.opacity='';currentIndex++;if(currentIndex>=10) endGame('complete');else showItem();},900);
      } else {
        score=Math.max(0,score-5); lives--; feedback(false); wrongSound(); bin.classList.add('wrong-drop');
        const card=item.querySelector('.trash-item'); card.classList.add('returning');
        document.getElementById('guide-text').textContent='Hãy quan sát và thử lại nhé!';
        updateStats(); setTimeout(()=>{bin.classList.remove('wrong-drop');card.classList.remove('returning');acceptingDrop=lives>0;if(lives<=0)endGame('lives');},650);
      }
      updateStats();
    }
    function endGame(reason) {
      stopTimer();stopMusic();acceptingDrop=false;
      const complete=reason==='complete', win=complete&&score>=80;
      document.getElementById('result-icon').textContent=win?'🏆':complete?'💚':'⏰';
      document.getElementById('result-title').textContent=win?'🎉 CHÚC MỪNG!':complete?'💚 CỐ GẮNG LÊN!':'⏰ GAME OVER';
      document.getElementById('result-message').textContent=win?'🌱 EM LÀ NGƯỜI HÙNG XANH!':complete?'Em đã hoàn thành thử thách. Hãy chơi lại để đạt điểm cao hơn nhé!':reason==='time'?'Thời gian đã hết!':'Em đã hết lượt!';
      document.getElementById('result-name').textContent=playerName;
      document.getElementById('result-score').textContent=score;
      document.getElementById('result-count').textContent=`${currentIndex}/10`;
      document.getElementById('result-extra').textContent=complete?`Lượt còn lại: ${lives} ❤️ — Cảm ơn em đã góp phần bảo vệ môi trường!`:'Hãy thử lại để làm công viên xanh sạch hơn nhé!';
      saveScore(); showScreen('result-screen');
      if(win){correctSound();setTimeout(confetti,250);}
      else tone(complete?390:160,.4,complete?'triangle':'sawtooth',.06);
    }
    function confetti(){['#f28b2b','#278bd7','#e54b4b','#58b85e','#ffe15d'].forEach((c,index)=>{for(let i=0;i<9;i++){const p=document.createElement('i');p.className='confetti';p.style.background=c;p.style.left=`${Math.random()*100}%`;p.style.setProperty('--x',`${(Math.random()-.5)*280}px`);p.style.animationDelay=`${index*35+i*22}ms`;document.body.appendChild(p);setTimeout(()=>p.remove(),3000)}});}
    function saveScore() {
      try { const scores=JSON.parse(localStorage.getItem('greenHeroScores')||'[]'); scores.push({name:playerName,score,date:Date.now()}); scores.sort((a,b)=>b.score-a.score||b.date-a.date); localStorage.setItem('greenHeroScores',JSON.stringify(scores.slice(0,10))); } catch(e){}
    }
    function renderLeaderboard() {
      let scores=[]; try{scores=JSON.parse(localStorage.getItem('greenHeroScores')||'[]')}catch(e){}
      if(!scores.length) scores=[{name:'Người Hùng Mẫu',score:100},{name:'Bạn Nhỏ Xanh',score:90},{name:'Lá Non',score:80}];
      const medals=['🥇','🥈','🥉'];
      document.getElementById('leaderboard-body').innerHTML=scores.slice(0,10).map((s,i)=>`<tr><td>${medals[i]||i+1}</td><td>${escapeHTML(s.name)}</td><td>${s.score}</td></tr>`).join('');
    }
    function escapeHTML(text){const d=document.createElement('div');d.textContent=text;return d.innerHTML;}
    function showLeaderboard(){renderLeaderboard();showScreen('leaderboard-screen');clickSound();}

    document.getElementById('start-home').onclick=()=>{showScreen('name-screen');clickSound();};
    document.getElementById('rules-home').onclick=()=>{showScreen('rules-screen');clickSound();};
    document.getElementById('leader-home').onclick=showLeaderboard;
    document.getElementById('sound-home').onclick=toggleSound; document.getElementById('sound-game').onclick=toggleSound;
    document.getElementById('name-back').onclick=()=>{showScreen('home-screen');clickSound();};
    document.getElementById('rules-back').onclick=()=>{showScreen('home-screen');clickSound();};
    document.getElementById('rules-play').onclick=()=>{showScreen('name-screen');clickSound();};
    document.getElementById('name-form').addEventListener('submit',e=>{e.preventDefault();const input=document.getElementById('player-name');playerName=input.value.trim();const err=document.getElementById('name-error');if(!playerName){err.textContent='Em hãy nhập tên người hùng trước nhé!';err.classList.remove('hidden');input.focus();return;}err.classList.add('hidden');startGame();});
    document.getElementById('result-replay').onclick=()=>{showScreen('name-screen');clickSound();};
    document.getElementById('result-ranking').onclick=showLeaderboard;
    document.getElementById('result-home').onclick=()=>{showScreen('home-screen');clickSound();};
    document.getElementById('leader-replay').onclick=()=>{showScreen('name-screen');clickSound();};
    document.getElementById('leader-home-back').onclick=()=>{showScreen('home-screen');clickSound();};

    let dragging=null, offsetX=0, offsetY=0;
    document.querySelectorAll('.trash-item').forEach(card=>{
      card.addEventListener('pointerdown',e=>{
        if(!acceptingDrop||!card.closest('.game-item').classList.contains('current'))return;
        dragging=card; const r=card.getBoundingClientRect();offsetX=e.clientX-r.left;offsetY=e.clientY-r.top;card.setPointerCapture(e.pointerId);card.classList.add('dragging');tone(320,.06,'sine',.025);
      });
      card.addEventListener('pointermove',e=>{
        if(dragging!==card)return;
        card.style.position='fixed';card.style.left=`${e.clientX-offsetX}px`;card.style.top=`${e.clientY-offsetY}px`;card.style.width=`${card.getBoundingClientRect().width}px`;
        bins.forEach(bin=>{const r=bin.getBoundingClientRect();const inside=e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom;bin.classList.toggle('active-drop',inside);});
      });
      card.addEventListener('pointerup',e=>{
        if(dragging!==card)return;
        let target=bins.find(bin=>{const r=bin.getBoundingClientRect();return e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom;});
        card.classList.remove('dragging');card.style.position='';card.style.left='';card.style.top='';card.style.width='';bins.forEach(b=>b.classList.remove('active-drop'));dragging=null;
        if(target)handleDrop(target.dataset.category,target);
      });
    });
    lucide.createIcons();
  </script>
 </body>
