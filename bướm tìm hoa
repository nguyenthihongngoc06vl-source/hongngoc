    @keyframes flutter { to { transform:translateX(-50%) rotate(-8deg) translateY(-5px); } }
    @keyframes popIn { from{opacity:0;transform:scale(.94) translateY(12px)} to{opacity:1;transform:scale(1) translateY(0)} }
    @keyframes shake { 25%{transform:translateX(-7px)} 50%{transform:translateX(7px)} 75%{transform:translateX(-4px)} }
    @keyframes sparkle { 50%{transform:scale(1.25) rotate(16deg)} }
