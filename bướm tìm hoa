    .flower-choice {
      position:relative; min-height:145px; border:0; cursor:pointer; background:transparent; color:#31513c;
      display:flex; flex-direction:column; align-items:center; justify-content:center; transition:transform .2s ease; outline-offset:5px;
    }
    .flower-choice:hover { transform:translateY(-8px) scale(1.03); }
    .flower-choice:focus-visible { outline:4px solid #31513c; border-radius:50%; }
    .flower-face {
      width:clamp(76px,11vw,120px); aspect-ratio:1; display:grid; place-items:center;
      border-radius:50%; background:#fff2a5; border:7px dotted #ff91ad;
