     <section id="finish" class="finish-view" aria-label="Màn hình hoàn thành">
      <div data-template-id="finish-card" class="canva-card finish-card">
       <div class="finish-butterfly" aria-hidden="true">
        🦋
       </div>
       <h2 data-template-id="finish-title" class="canva-text font-black text-2xl sm:text-4xl"></h2>
       <div class="text-3xl mt-2" aria-hidden="true">
        🌸 ✦ 🌼 ✦ 🌸
       </div>
       <table class="math-table" aria-label="Bảng phép tính đã hoàn thành">
        <tbody>
         <tr>
          <th data-template-id="table-row-label-1" class="canva-text"></th>
          <td data-template-id="table-18" class="canva-text"></td>
          <td data-template-id="table-22-first" class="canva-text found"></td>
          <td data-template-id="table-21" class="canva-text"></td>
          <td data-template-id="table-22-second" class="canva-text found"></td>
          <td data-template-id="table-60" class="canva-text"></td>
         </tr>
         <tr>
          <th data-template-id="table-row-label-2" class="canva-text"></th>
          <td data-template-id="table-12" class="canva-text"></td>
          <td data-template-id="table-16" class="canva-text"></td>
          <td data-template-id="table-33" class="canva-text found"></td>
          <td data-template-id="table-18-second" class="canva-text"></td>
          <td data-template-id="table-110" class="canva-text found"></td>
