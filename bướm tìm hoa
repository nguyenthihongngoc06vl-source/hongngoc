  <script src="/_sdk/0ddbbee1c66b1212.editing_sdk.js" integrity="sha512-HQn5LM1yruQSbY78ATUril6QeOJ9xj7KqO64ltLtb4vBwI5Qv3/tloFFOndBPZTNZoeV5xKzuth5y6FTi9crsg=="></script>
  <script>
    let soundOn = true;
    let audioContext = null;
    let musicTimer = null;
    let currentQuestion = 1;
    let locked = false;

    function getAudio() {
      if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
      if (audioContext.state === "suspended") audioContext.resume();
      return audioContext;
    }

    function tone(freq, duration, type, volume, delay) {
      if (!soundOn) return;
      const ctx = getAudio(), oscillator = ctx.createOscillator(), gain = ctx.createGain();
      oscillator.type = type || "sine";
      oscillator.frequency.setValueAtTime(freq, ctx.currentTime + (delay || 0));
      gain.gain.setValueAtTime(volume || 0.05, ctx.currentTime + (delay || 0));
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + (delay || 0) + duration);
      oscillator.connect(gain); gain.connect(ctx.destination);
      oscillator.start(ctx.currentTime + (delay || 0)); oscillator.stop(ctx.currentTime + (delay || 0) + duration);
    }

    function startMusic() {
      if (!soundOn || musicTimer) return;
      const melody = [523, 659, 784, 659, 587, 698, 784, 698];
      let note = 0;
      musicTimer = setInterval(() => {
        if (soundOn) tone(melody[note++ % melody.length], 0.22, "triangle", 0.018);
      }, 460);
    }

    function stopMusic() {
      clearInterval(musicTimer);
      musicTimer = null;
    }

    function playCorrect() {
      tone(880, .12, "sine", .09);
      tone(1175, .25, "sine", .08, .12);
    }
    function playWrong() {
      tone(220, .17, "triangle", .055);
      tone(180, .2, "triangle", .045, .13);
    }
    function playFly() {
      tone(480, .07, "sine", .025);
      tone(620, .08, "sine", .02, .09);
    }
    function playWin() {
      [523,659,784,1047].forEach((note, index) => tone(note, .32, "triangle", .07, index * .12));
    }

    function showQuestion(number) {
      document.querySelectorAll(".question-view").forEach(view => view.classList.remove("active"));
      document.getElementById("q" + number).classList.add("active");
      document.getElementById("progress-fill").style.width = (number * 25) + "%";
      currentQuestion = number;
      locked = false;
      const butterfly = document.getElementById("butterfly-" + number);
      butterfly.classList.remove("perched", "intro-perched");
      butterfly.style.left = "";
      butterfly.style.top = "";
      void butterfly.offsetWidth;
      butterfly.classList.add("intro-perched");
      playFly();
    }

    function showFinish() {
      document.querySelectorAll(".question-view").forEach(view => view.classList.remove("active"));
      document.getElementById("finish").classList.add("active");
      document.getElementById("progress-fill").style.width = "100%";
      playWin();
    }

    document.querySelectorAll(".flower-choice").forEach(button => {
      button.addEventListener("click", () => {
        if (locked || Number(button.dataset.question) !== currentQuestion) return;
        startMusic();
        const question = button.dataset.question;
        const feedback = document.getElementById("feedback-" + question);

        if (button.dataset.correct === "true") {
          locked = true;
          button.classList.add("correct");
          const flowerBox = button.getBoundingClientRect();
          const cardBox = document.getElementById("q" + question).querySelector(".math-card").getBoundingClientRect();
          const butterfly = document.getElementById("butterfly-" + question);
          butterfly.style.left = (flowerBox.left - cardBox.left + flowerBox.width / 2) + "px";
          butterfly.style.top = (flowerBox.top - cardBox.top - 26) + "px";
          butterfly.classList.add("perched");
          feedback.textContent = "CHÍNH XÁC! 🎉";
          feedback.className = "feedback good";
          playCorrect();

          setTimeout(() => {
            if (Number(question) === 4) showFinish();
            else showQuestion(Number(question) + 1);
          }, 1500);
        } else {
          button.classList.remove("wrong");
          void button.offsetWidth;
          button.classList.add("wrong");
          feedback.textContent = "CHƯA ĐÚNG! HÃY THỬ LẠI NHÉ! 🌸";
          feedback.className = "feedback bad";
          playWrong();
        }
      });
    });

    document.getElementById("sound-toggle").addEventListener("click", () => {
      soundOn = !soundOn;
      const iconHost = document.getElementById("sound-toggle");
      iconHost.innerHTML = soundOn ? '<i data-lucide="volume-2" width="22" height="22"></i>' : '<i data-lucide="volume-x" width="22" height="22"></i>';
      lucide.createIcons();
      if (soundOn) { getAudio(); startMusic(); } else stopMusic();
    });

    document.getElementById("restart-game").addEventListener("click", () => {
      document.getElementById("finish").classList.remove("active");
      document.querySelectorAll(".flower-choice").forEach(button => button.classList.remove("correct", "wrong"));
      document.querySelectorAll(".feedback").forEach(item => { item.textContent = ""; item.className = "feedback"; });
      document.querySelectorAll(".butterfly").forEach(item => { item.style.left = "50%"; item.style.top = "-42px"; item.classList.remove("perched"); });
      showQuestion(1);
    });

    lucide.createIcons();
  </script>
