    .flower-choice.correct .flower-face { transform:scale(1.18) rotate(7deg); box-shadow:0 0 0 9px rgba(255,206,70,.34), 0 0 25px 7px #fff0a3; }
    .flower-choice.wrong { animation: shake .42s ease; }
