  <style>
    :root {
      --ink: #31513c;
      --cream: #fffdf3;
      --leaf: #4c9a61;
      --rose: #f06f92;
      --sun: #ffc94d;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      width: 100%;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      font-family: "M PLUS Rounded 1c", sans-serif;
