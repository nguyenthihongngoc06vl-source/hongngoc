    .math-table th,.math-table td { padding:clamp(9px,1.7vw,16px) 8px; border-right:2px solid #78b46c; border-bottom:2px solid #78b46c; text-align:center; color:#31513c; background:#fffefa; }
    .math-table tr:last-child th,.math-table tr:last-child td { border-bottom:0; }
    .math-table td:last-child,.math-table th:last-child { border-right:0; }
    .math-table th { width:22%; background:#d9f0c4; font-weight:900; }
    .math-table .found { background:#fff0a4; color:#d14f71; font-weight:900; position:relative; }
    .math-table .found::after { content:"✓"; font-size:.7em; margin-left:3px; color:#39a365; }
    .final-cheer { font-size:clamp(1rem,2.3vw,1.35rem); color:#d45b78; font-weight:900; }
