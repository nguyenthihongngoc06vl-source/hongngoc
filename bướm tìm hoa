    }
    .flower-choice:nth-child(2) .flower-face { border-color:#bf80e9; background:#fff0ff; }
    .flower-choice:nth-child(3) .flower-face { border-color:#f09062; background:#fff1d0; }
    .flower-choice:nth-child(4) .flower-face { border-color:#61bad6; background:#e9fbff; }
