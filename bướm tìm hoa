    .garden-sky {
      position: relative;
      min-height: calc(100 * min(var(--vh, 1vh), 1vh));
      overflow: hidden;
      background:
        radial-gradient(circle at 12% 10%, rgba(255,255,255,.9) 0 2%, transparent 2.5%),
        radial-gradient(circle at 78% 18%, rgba(255,255,255,.75) 0 3%, transparent 3.5%),
        linear-gradient(180deg, #a9e6f6 0%, #dff6d3 55%, #a6d976 100%);
    }
    .garden-sky::before {
      content: "";
      position: absolute;
      inset: auto -5% -65px;
      height: 180px;
      z-index: 0;
      border-radius: 50% 50% 0 0;
      background: #72bd61;
      box-shadow: 0 -34px 0 #8dd276, 120px -12px 0 #9cdb79, -160px -20px 0 #8bcf6e;
    }
    .cloud { position:absolute; color:rgba(255,255,255,.82); filter: drop-shadow(0 4px 1px rgba(71,142,156,.12)); font-size: clamp(2.5rem,5vw,5rem); animation: drift 8s ease-in-out infinite alternate; }
    .cloud.one { left:5%; top:9%; } .cloud.two { right:7%; top:18%; animation-delay:-3s; }
    .petal { position:absolute; z-index:1; font-size:clamp(1.2rem,2.4vw,2.2rem); animation: float 5s ease-in-out infinite; }
    .petal.a { left:4%; bottom:18%; } .petal.b { right:5%; bottom:15%; animation-delay:-2s; } .petal.c { right:15%; top:38%; animation-delay:-1s; }
    .game-panel {
      position: relative; z-index: 2; width: min(1080px, 94vw);
      min-height: min(690px, calc(92 * min(var(--vh, 1vh), 1vh)));
      margin: 0 auto; padding: clamp(18px,3vw,34px);
      display:flex; flex-direction:column;
    }
    .topbar {
      display:flex; align-items:center; justify-content:space-between; gap:16px;
      padding: 12px 18px; border-radius: 24px;
      background: rgba(255,253,243,.88); border: 3px solid rgba(255,255,255,.9);
      box-shadow: 0 9px 0 rgba(71,130,72,.16);
    }
    .sound-button { width:46px; height:46px; border-radius:50%; display:grid; place-items:center; border:2px solid #7ab96d; cursor:pointer; transition:transform .2s; }
    .sound-button:hover { transform:rotate(-8deg) scale(1.06); }
    .progress-track { height: 12px; width: min(270px, 28vw); background:#d7efd2; border-radius:999px; overflow:hidden; }
