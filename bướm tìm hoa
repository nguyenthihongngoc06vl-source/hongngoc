    .math-card {
      position:relative; width:min(760px,100%); margin:0 auto;
      padding: clamp(24px,4vw,42px); text-align:center;
      border:4px solid #fff; border-radius:36px;
      background:rgba(255,253,243,.94); box-shadow:0 13px 0 rgba(59,114,63,.17);
    }
    .math-card::after { content:"🌿"; position:absolute; top:-22px; right:24px; font-size:42px; transform:rotate(14deg); }
    .formula { color:#31513c; font-size:clamp(2.1rem,6vw,4.5rem); letter-spacing:.05em; line-height:1.1; }
    .question-text { margin-top:12px; color:#54735b; font-size:clamp(1rem,2vw,1.28rem); }
    .butterfly {
      position:absolute; left:50%; top:-42px; z-index:5; font-size:clamp(3rem,6vw,4.8rem);
      transform:translateX(-50%); transition:left .85s cubic-bezier(.2,.8,.2,1), top .85s cubic-bezier(.2,.8,.2,1), transform .3s;
      animation: flutter .62s ease-in-out infinite alternate;
      filter:drop-shadow(0 8px 5px rgba(48,91,57,.23));
    }
    .butterfly.intro-perched { left:14%; top:57%; animation: landOnFlower 1.15s cubic-bezier(.2,.8,.2,1) both, flutter .62s ease-in-out 1.15s infinite alternate; }
