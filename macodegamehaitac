    <aside id="leaderboard" class="leaderboard" aria-label="Bảng xếp hạng">
     <div class="leader-card">
      <h2 data-template-id="ranking-title" class="canva-text"></h2>
      <div id="leaderboard-list"></div><button id="close-ranking" data-template-id="close-ranking-button" class="canva-button retry" type="button"></button>
     </div>
