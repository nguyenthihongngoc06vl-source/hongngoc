     </div>
     <div id="wrong-notice" class="notice wrong" role="alert">
      <h2 data-template-id="wrong-heading" class="canva-text"></h2>
      <p data-template-id="wrong-message" class="canva-text"></p><button id="retry-button" data-template-id="retry-button" class="canva-button retry" type="button"></button>
     </div>
     <div id="gameover-notice" class="notice gameover" role="alert">
      <h2 data-template-id="gameover-heading" class="canva-text"></h2>
      <p data-template-id="gameover-message" class="canva-text"></p><button id="gameover-button" data-template-id="gameover-button" class="canva-button retry" type="button"></button>
     </div>
    </section>
    <section id="final-screen" class="screen final-screen" aria-labelledby="final-title">
     <div class="final-content">
      <div class="treasure-animation" aria-label="Rương kho báu đang mở">
       🧰✨
      </div>
      <h1 id="final-title" data-template-id="final-title" class="canva-text final-title"></h1>
      <p data-template-id="final-subtitle" class="canva-text final-subtitle"></p>
      <div class="reward-grid">
       <div class="trophy-card" aria-label="Cúp Thần đồng Toán học">
        🏆
       </div>
       <article class="certificate">
        <h2 data-template-id="certificate-label" class="canva-text"></h2>
        <p data-template-id="certificate-award" class="canva-text"></p>
        <h3 data-template-id="certificate-title" class="canva-text"></h3>
