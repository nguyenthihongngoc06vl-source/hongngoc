        <p data-template-id="certificate-description" class="canva-text"></p>
        <p id="certificate-score"></p>
        <p data-template-id="certificate-congrats" class="canva-text"></p>
       </article>
      </div>
      <div class="final-actions">
       <button id="final-rank-button" data-template-id="ranking-button" class="canva-button small-action" type="button"></button><button id="restart-button" data-template-id="restart-button" class="canva-button small-action orange" type="button"></button>
      </div>
