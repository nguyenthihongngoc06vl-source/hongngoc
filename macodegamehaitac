   </section>
  </main>
  <script src="/_sdk/0aac212797dcb9a6.editing_sdk.js" integrity="sha512-U1Z5TGB/MTX0fFSADhP7rVM3+UzJJjKTapiY1vm1cxcbcyWo4eBuCJNJO6zARJ5kHopP9UvWNtPszOqzRc1ICA=="></script>
  <script>
    const challenges = [
      {equation:"247 + 386 = ?",answer:"633",options:["A. 623","B. 633","C. 643","D. 653"],name:"ĐẢO 1",theme:"Đảo Cây Cọ",ground:"",decor:["🌴","🌴","🪵","🗺️"]},
      {equation:"458 + 267 = ?",answer:"725",options:["A. 715","B. 725","C. 735","D. 745"],name:"ĐẢO 2",theme:"Đảo Vàng",ground:"",decor:["🌴","🌴","💰💎","🗝️"]},
      {equation:"824 − 357 = ?",answer:"467",options:["A. 457","B. 467","C. 477","D. 487"],name:"ĐẢO 3",theme:"Đảo Hang Động",ground:"rock",decor:["⛰️","💎","🔥","🪨"]},
      {equation:"731 − 284 = ?",answer:"447",options:["A. 437","B. 447","C. 457","D. 467"],name:"ĐẢO 4",theme:"Đảo Bí Mật",ground:"green",decor:["🌴","🌿","🧭","📜"]},
      {equation:"369 + 458 = ?",answer:"827",options:["A. 817","B. 827","C. 837","D. 847"],name:"ĐẢO 5",theme:"Đảo Kho Báu",ground:"",decor:["🌴","🌴","💎💰","🔑🧰"]}
    ];
    const positions=[{left:"3%",top:"51%"},{left:"11%",top:"22%"},{left:"35%",top:"42%"},{left:"61%",top:"22%"},{left:"64%",top:"66%"},{left:"28%",top:"77%"},{left:"83%",top:"76%"}];
    const screens={start:document.getElementById("start-screen"),map:document.getElementById("map-screen"),island:document.getElementById("island-screen"),final:document.getElementById("final-screen")};
    let playerName="",islandIndex=0,score=0,lives=3,soundOn=true,audioContext=null,oceanTimer=null,locked=false;

    function showScreen(name){Object.values(screens).forEach(s=>s.classList.remove("active"));screens[name].classList.add("active")}
    function tone(freq,duration=.16,type="triangle",volume=.06){if(!soundOn||!audioContext)return;const o=audioContext.createOscillator(),g=audioContext.createGain();o.type=type;o.frequency.value=freq;g.gain.setValueAtTime(volume,audioContext.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioContext.currentTime+duration);o.connect(g).connect(audioContext.destination);o.start();o.stop(audioContext.currentTime+duration)}
    function melody(notes){notes.forEach((n,i)=>setTimeout(()=>tone(n,.22,"triangle",.08),i*115))}
    function beginAudio(){if(!soundOn)return;if(!audioContext)audioContext=new(window.AudioContext||window.webkitAudioContext)();if(audioContext.state==="suspended")audioContext.resume();if(!oceanTimer)oceanTimer=setInterval(()=>tone(115,.09,"sine",.014),1700)}
    function updateHud(){const hearts="❤️ ".repeat(lives).trim()||"💔";["life-display","island-life-display"].forEach(id=>document.getElementById(id).textContent=hearts);["score-display","island-score-display"].forEach(id=>document.getElementById(id).textContent="⭐ "+score+" điểm");["journey-display","island-journey-display"].forEach(id=>document.getElementById(id).textContent="🗺️ "+Math.min(islandIndex+1,5)+"/5")}
    function updateMap(){document.querySelectorAll(".map-island").forEach((node,i)=>{node.classList.toggle("locked",i>islandIndex);node.classList.toggle("done",i<islandIndex);node.classList.toggle("current",i===islandIndex&&islandIndex<5)})}
    function moveShip(pos,cb){const ship=document.getElementById("ship-marker");ship.style.left=pos.left;ship.style.top=pos.top;tone(150,.36,"sawtooth",.035);setTimeout(cb,1680)}
    function startGame(){playerName=document.getElementById("pirate-name").value.trim()||"Thuyền trưởng Nhí";islandIndex=0;score=0;lives=3;locked=false;updateHud();updateMap();showScreen("map");document.getElementById("ship-marker").style.left=positions[0].left;document.getElementById("ship-marker").style.top=positions[0].top;document.getElementById("map-pirate").classList.add("running");setTimeout(()=>moveShip(positions[1],()=>{document.getElementById("map-pirate").classList.remove("running");openIsland()}),400)}
    function openIsland(){locked=false;const q=challenges[islandIndex];showScreen("island");updateHud();document.getElementById("island-name").textContent=q.name;document.getElementById("island-theme").textContent=q.theme;document.getElementById("equation").textContent=q.equation;document.getElementById("ground").className="scene-ground "+q.ground;["decor-one","decor-two","decor-three","decor-four"].forEach((id,i)=>document.getElementById(id).textContent=q.decor[i]);document.querySelectorAll(".notice").forEach(n=>n.classList.remove("show"));document.getElementById("challenge-panel").style.visibility="hidden";const pirate=document.getElementById("island-pirate");pirate.className="pirate running";tone(420,.13,"sine",.045);setTimeout(()=>{pirate.classList.remove("running");renderChoices(q);document.getElementById("challenge-panel").style.visibility="visible";tone(620,.15,"triangle",.045)},950)}
    function renderChoices(q){const choices=document.getElementById("choices");choices.replaceChildren();q.options.forEach(option=>{const button=document.createElement("button");button.type="button";button.className="choice";button.textContent=option;button.dataset.answer=option.slice(3);button.addEventListener("click",()=>answer(button.dataset.answer));choices.appendChild(button)})}
    function answer(value){if(locked)return;locked=true;tone(450,.08,"sine",.04);const pirate=document.getElementById("island-pirate");if(value===challenges[islandIndex].answer){score+=100;updateHud();pirate.classList.add("jumping");document.getElementById("sparkles").classList.add("show");document.getElementById("correct-notice").classList.add("show");melody([523,659,784]);setTimeout(()=>travelNext(),1650)}else{lives--;updateHud();pirate.classList.add("surprised");tone(190,.22,"sine",.07);if(lives===0){document.getElementById("gameover-notice").classList.add("show")}else{document.getElementById("wrong-notice").classList.add("show")}}}
    function retry(){locked=false;document.getElementById("wrong-notice").classList.remove("show");const pirate=document.getElementById("island-pirate");pirate.classList.remove("surprised")}
    function travelNext(){document.getElementById("correct-notice").classList.remove("show");document.getElementById("sparkles").classList.remove("show");islandIndex++;updateMap();showScreen("map");document.getElementById("map-pirate").classList.add("running");moveShip(positions[islandIndex+1],()=>{document.getElementById("map-pirate").classList.remove("running");if(islandIndex===5)finishGame();else openIsland()})}
    function finishGame(){saveScore();showScreen("final");document.getElementById("certificate-name").textContent="Học sinh: "+playerName;document.getElementById("certificate-score").textContent="⭐ Điểm số: "+score+" / 500";melody([392,523,659,784,1046]);renderLeaderboard()}
    function saveScore(){const key="pirateTreasureRanking";let data=[];try{data=JSON.parse(localStorage.getItem(key)||"[]")}catch(e){}data.push({name:playerName,score,completed:5,date:Date.now()});data.sort((a,b)=>b.score-a.score||a.date-b.date);localStorage.setItem(key,JSON.stringify(data.slice(0,10)))}
    function renderLeaderboard(){const list=document.getElementById("leaderboard-list");let rows=[];try{rows=JSON.parse(localStorage.getItem("pirateTreasureRanking")||"[]")}catch(e){}const sample=[{name:"Hải tặc Sao Biển",score:500},{name:"Thuyền trưởng Nhí",score:400},{name:"Bạn Cá Heo",score:300}];rows=(rows.length?rows:sample).sort((a,b)=>b.score-a.score).slice(0,3);list.replaceChildren();["🥇","🥈","🥉"].forEach((medal,i)=>{if(!rows[i])return;const row=document.createElement("div");row.className="leader-row";row.innerHTML="<span>"+medal+" Hạng "+(i+1)+" – "+rows[i].name+"</span><span>"+rows[i].score+" điểm</span>";list.appendChild(row)})}
    function toggleLeaderboard(){renderLeaderboard();document.getElementById("leaderboard").classList.toggle("open")}
    function restart(){document.getElementById("pirate-name").value="";showScreen("start");document.getElementById("pirate-name").focus()}
    document.getElementById("start-form").addEventListener("submit",e=>{e.preventDefault();beginAudio();tone(520,.14,"triangle",.06);startGame()});
    document.getElementById("retry-button").addEventListener("click",retry);document.getElementById("gameover-button").addEventListener("click",restart);document.getElementById("restart-button").addEventListener("click",restart);
    ["rank-toggle","final-rank-button","close-ranking"].forEach(id=>document.getElementById(id).addEventListener("click",toggleLeaderboard));
    document.getElementById("sound-toggle").addEventListener("click",()=>{soundOn=!soundOn;document.getElementById("sound-state").textContent=soundOn?"ON":"OFF";if(!soundOn&&audioContext){clearInterval(oceanTimer);oceanTimer=null;audioContext.suspend()}else{beginAudio();tone(520,.12,"triangle",.05)}});
    document.addEventListener("DOMContentLoaded",()=>lucide.createIcons());
  </script>
