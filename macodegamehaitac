      <div id="island-pirate" class="pirate">
       <span class="hat">🏴‍☠️</span><span class="face"></span><span class="body"></span><span class="arm"></span>
      </div>
     </div>
     <div id="sparkles" class="sparkles">
      ✨🪙⭐
     </div>
     <section id="challenge-panel" class="challenge" aria-live="polite">
      <h2 data-template-id="challenge-title" class="canva-text"></h2>
      <div id="equation" class="equation"></div>
      <div id="choices" class="choices"></div>
     </section>
     <div id="correct-notice" class="notice correct" role="status">
      <h2 data-template-id="correct-heading" class="canva-text"></h2>
