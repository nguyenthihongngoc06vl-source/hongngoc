      document.getElementById("piece-3")
    ];

    function getAudioContext() {
      if (!audioContext) {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioContext.state === "suspended") audioContext.resume();
      return audioContext;
    }

    function tone(frequency, duration, type, volume, delay) {
      if (!soundEnabled) return;
      const ctx = getAudioContext();
      const oscillator = ctx.createOscillator();
      const gain = ctx.createGain();
      const start = ctx.currentTime + (delay || 0);
      oscillator.type = type || "sine";
      oscillator.frequency.setValueAtTime(frequency, start);
      gain.gain.setValueAtTime(0.0001, start);
      gain.gain.exponentialRampToValueAtTime(volume || 0.08, start + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);
      oscillator.connect(gain).connect(ctx.destination);
      oscillator.start(start);
      oscillator.stop(start + duration + 0.03);
    }

    function clickSound() { tone(520, 0.07, "sine", 0.045); }
    function wrongSound() { tone(170, 0.18, "triangle", 0.08); }
    function correctSound() {
      tone(740, 0.14, "sine", 0.09);
      tone(1050, 0.22, "sine", 0.08, 0.12);
    }
    function winSound() {
      [523, 659, 784, 1047].forEach((note, index) => tone(note, 0.22, "sine", 0.08, index * 0.13));
    }

    function startBackgroundMusic() {
      if (backgroundTimer || !soundEnabled) return;
      const notes = [392, 494, 587, 494, 440, 523, 659, 523];
      let index = 0;
      backgroundTimer = setInterval(() => {
        if (soundEnabled) tone(notes[index++ % notes.length], 0.16, "sine", 0.025);
      }, 900);
    }

    function updateProgress() {
      const completed = currentQuestion;
      document.getElementById("progress-count").textContent = completed + "/3";
      document.getElementById("progress-fill").style.width = (completed / 3 * 100) + "%";
    }

    function hideFeedback(panel) {
      panel.querySelectorAll(".feedback").forEach(item => item.classList.remove("visible"));
    }

    function showQuestion(index) {
      panels.forEach((panel, panelIndex) => {
        panel.classList.toggle("active", panelIndex === index);
        hideFeedback(panel);
      });
    }

    function revealPiece(index) {
      const piece = pieces[index];
      piece.classList.add("revealed", "just-revealed");
      setTimeout(() => piece.classList.remove("just-revealed"), 800);
    }

    function wrongAnswer(button) {
      clickSound();
      wrongSound();
      const panel = panels[currentQuestion];
      hideFeedback(panel);
      panel.querySelector(".feedback:not(.success-feedback)").classList.add("visible");
      button.classList.remove("wrong-shake");
      void button.offsetWidth;
      button.classList.add("wrong-shake");
    }

    function correctAnswer(button) {
      clickSound();
      correctSound();
      const solvedIndex = currentQuestion;
      const panel = panels[solvedIndex];
      hideFeedback(panel);
      panel.querySelector(".success-feedback").classList.add("visible");
      button.classList.add("correct-flash");
      panel.querySelectorAll(".answer").forEach(answer => answer.disabled = true);
      revealPiece(solvedIndex);
      currentQuestion += 1;
      updateProgress();

      setTimeout(() => {
        if (currentQuestion < 3) {
          showQuestion(currentQuestion);
        } else {
          winSound();
          document.getElementById("win-screen").classList.add("visible");
        }
      }, 950);
    }

    document.querySelectorAll(".answer").forEach(button => {
      button.addEventListener("click", () => {
        startBackgroundMusic();
        if (button.dataset.correct === "true") correctAnswer(button);
        else wrongAnswer(button);
      });
    });

    document.getElementById("sound-toggle").addEventListener("click", function () {
      soundEnabled = !soundEnabled;
      this.setAttribute("aria-pressed", String(soundEnabled));
      this.innerHTML = soundEnabled
        ? '<i data-lucide="volume-2" width="24" height="24"></i>'
        : '<i data-lucide="volume-x" width="24" height="24"></i>';
      if (soundEnabled) {
        tone(620, 0.1, "sine", 0.05);
        startBackgroundMusic();
      } else if (backgroundTimer) {
        clearInterval(backgroundTimer);
        backgroundTimer = null;
      }
      lucide.createIcons();
    });

    document.getElementById("replay-button").addEventListener("click", () => {
      document.getElementById("win-screen").classList.remove("visible");
      currentQuestion = 0;
      pieces.forEach(piece => piece.classList.remove("revealed", "just-revealed"));
      panels.forEach(panel => {
        panel.querySelectorAll(".answer").forEach(answer => {
          answer.disabled = false;
          answer.classList.remove("correct-flash", "wrong-shake");
        });
        hideFeedback(panel);
      });
      updateProgress();
      showQuestion(0);
      clickSound();
    });

    lucide.createIcons();
  </script>
 </body>
</html>
