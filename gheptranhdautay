  <script>
    let currentQuestion = 0;
    let soundEnabled = true;
    let audioContext = null;
    let backgroundTimer = null;

    const panels = [
      document.getElementById("question-panel-1"),
      document.getElementById("question-panel-2"),
      document.getElementById("question-panel-3")
    ];
    const pieces = [
      document.getElementById("piece-1"),
