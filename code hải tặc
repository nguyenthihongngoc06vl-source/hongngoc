    function formatTime(totalSeconds) {
      const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, "0");
      const seconds = (totalSeconds % 60).toString().padStart(2, "0");
      return `${minutes}:${seconds}`;
    }

    function shuffle(items) {
      const copy = [...items];
      for (let i = copy.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function showStatus(message) {
      el.statusMessage.textContent = message;
      el.statusMessage.classList.add("show");
      clearTimeout(showStatus.timeout);
      showStatus.timeout = setTimeout(() => el.statusMessage.classList.remove("show"), 2300);
    }

    function updateHud() {
      const total = zones.length;
      const progress = Math.min((state.index / total) * 100, 100);
      el.heartsValue.textContent = state.hearts;
      el.scoreValue.textContent = state.score;
      el.coinValue.textContent = state.coins;
      el.correctValue.textContent = state.correct;
      el.timeValue.textContent = formatTime(state.elapsed);
      el.progressFill.style.width = `${progress}%`;
      el.routeShip.style.left = `${progress}%`;
    }

    function hasCarryingAddition(a, b) {
      let x = a;
      let y = b;
      let carry = 0;
      for (let i = 0; i < 3; i += 1) {
        const sum = (x % 10) + (y % 10) + carry;
        if (sum >= 10) return true;
        carry = Math.floor(sum / 10);
        x = Math.floor(x / 10);
        y = Math.floor(y / 10);
      }
      return false;
    }

    function hasBorrowSubtraction(a, b) {
      let x = a;
      let y = b;
      for (let i = 0; i < 3; i += 1) {
        if ((x % 10) < (y % 10)) return true;
        x = Math.floor(x / 10);
        y = Math.floor(y / 10);
      }
      return false;
    }

    function makeQuestion(existingExpressions) {
      let tries = 0;
      while (tries < 300) {
        tries += 1;
        const addition = Math.random() > .5;
        let first;
        let second;
        let answer;
        let expression;

        if (addition) {
          first = 120 + Math.floor(Math.random() * 720);
          second = 110 + Math.floor(Math.random() * (999 - first));
          answer = first + second;
          expression = `${first} + ${second}`;
          if (!hasCarryingAddition(first, second)) continue;
        } else {
          first = 340 + Math.floor(Math.random() * 620);
          second = 120 + Math.floor(Math.random() * Math.min(650, first - 100));
          answer = first - second;
          expression = `${first} − ${second}`;
          if (!hasBorrowSubtraction(first, second)) continue;
        }

        if (existingExpressions.has(expression)) continue;
        existingExpressions.add(expression);

        const options = new Set([answer]);
        const offsets = shuffle([-100, -50, -20, -10, -5, 5, 10, 20, 50, 100]);
        for (const offset of offsets) {
          const candidate = answer + offset;
          if (candidate > 0 && candidate <= 1000) options.add(candidate);
          if (options.size === 4) break;
        }

        while (options.size < 4) {
          const candidate = Math.max(1, Math.min(1000, answer + (Math.floor(Math.random() * 120) - 60)));
          options.add(candidate);
        }

        return { expression, answer, options: shuffle([...options]) };
      }

      return { expression: "487 + 258", answer: 745, options: [735, 745, 755, 765] };
    }

    function generateQuestions() {
      const expressions = new Set();
      return Array.from({ length: zones.length }, () => makeQuestion(expressions));
    }

    function initAudio() {
      if (!state.soundOn || state.audioContext) return;
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (AudioContext) state.audioContext = new AudioContext();
    }

    function playTone(type) {
      if (!state.soundOn) return;
      initAudio();
      if (!state.audioContext) return;

      const ctx = state.audioContext;
      if (ctx.state === "suspended") ctx.resume();

      const settings = {
        click: { frequency: 420, end: 520, duration: .09, wave: "sine" },
        sail: { frequency: 210, end: 290, duration: .24, wave: "triangle" },
        correct: { frequency: 660, end: 950, duration: .24, wave: "triangle" },
        wrong: { frequency: 180, end: 110, duration: .28, wave: "sawtooth" },
        coin: { frequency: 960, end: 1320, duration: .15, wave: "sine" },
        chest: { frequency: 420, end: 740, duration: .24, wave: "triangle" },
        win: { frequency: 523, end: 1046, duration: .6, wave: "triangle" },
        music: { frequency: arguments[1] || 330, end: (arguments[1] || 330) * 1.01, duration: .18, wave: "triangle" }
      }[type] || { frequency: 440, end: 440, duration: .12, wave: "sine" };

      const oscillator = ctx.createOscillator();
      const gain = ctx.createGain();
      const now = ctx.currentTime;

      oscillator.type = settings.wave;
      oscillator.frequency.setValueAtTime(settings.frequency, now);
      oscillator.frequency.exponentialRampToValueAtTime(settings.end, now + settings.duration);
      gain.gain.setValueAtTime(.0001, now);
      gain.gain.exponentialRampToValueAtTime(.13, now + .02);
      gain.gain.exponentialRampToValueAtTime(.0001, now + settings.duration);

      oscillator.connect(gain);
      gain.connect(ctx.destination);
      oscillator.start(now);
      oscillator.stop(now + settings.duration);
    }

    function playBackgroundMusic() {
      if (!state.soundOn) return;
      clearInterval(state.musicTimer);
      const notes = [262, 330, 392, 523, 392, 330];
      let noteIndex = 0;
      state.musicTimer = setInterval(() => {
        if (state.running && !state.paused) playTone("music", notes[noteIndex++ % notes.length]);
      }, 520);
    }

    function stopBackgroundMusic() {
      clearInterval(state.musicTimer);
      state.musicTimer = null;
    }

    function toggleSound() {
      state.soundOn = !state.soundOn;
      el.soundButton.innerHTML = state.soundOn
        ? '<i data-lucide="volume-2" width="19" height="19"></i>'
        : '<i data-lucide="volume-x" width="19" height="19"></i>';
      lucide.createIcons();
      showStatus(state.soundOn ? "🔊 Đã bật âm thanh!" : "🔇 Đã tắt âm thanh!");
      if (state.soundOn) playTone("coin");
    }

    function startGameTimer() {
      clearInterval(state.gameTimer);
      state.gameTimer = setInterval(() => {
        if (state.running && !state.paused) {
          state.elapsed += 1;
          el.timeValue.textContent = formatTime(state.elapsed);
        }
      }, 1000);
    }

    function updateMap() {
      zones.forEach((zone, index) => {
        const island = document.getElementById(`island-${index + 1}`);
        const icon = island.querySelector(".island-state");
        island.classList.remove("locked", "active", "completed");

        if (index < state.index) {
          island.classList.add("completed");
          icon.textContent = "✔";
        } else if (index === state.index) {
          island.classList.add("active");
          icon.textContent = index + 1;
        } else {
          island.classList.add("locked");
          icon.textContent = "🔒";
        }
      });

      const position = shipPositions[Math.min(state.index, shipPositions.length - 1)];
      el.mapShip.style.left = position.left;
      el.mapShip.style.top = position.top;
      el.mapStatus.textContent = `Điểm đến tiếp theo: ${zones[state.index].name}.`;
    }

    function sailToZone() {
      if (!state.running || state.index >= zones.length) return;
      el.sailButton.disabled = true;
      el.mapStatus.textContent = `⛵ Tàu đang ra khơi đến ${zones[state.index].name}...`;
      playTone("sail");

      setTimeout(() => {
        el.mapScreen.classList.add("hidden");
        el.adventureScreen.classList.remove("hidden");
        setupScene();
        el.sailButton.disabled = false;
      }, 950);
    }

    function setupScene() {
      const zone = zones[state.index];
      el.sceneTitle.textContent = zone.name;
      el.sceneCopy.textContent = zone.copy;
      el.sceneWorld.style.transform = `translateX(${zone.camera})`;
      el.checkpoint.style.left = zone.checkpoint;
      el.pirate.style.left = `${parseFloat(zone.checkpoint) - 17}%`;
      el.pirate.className = "pirate";
      el.finishChest.classList.toggle("hidden", state.index !== zones.length - 1);
      el.checkpoint.classList.toggle("hidden", state.index === zones.length - 1);
      el.checkpointLabel.textContent = state.index === zones.length - 1
        ? "Hãy mở rương vàng huyền thoại!"
        : "Chạm cờ để mở thử thách toán học!";
    }

    function openQuestion() {
      if (!state.running || (!state.finalChallenge && state.index >= state.questions.length)) return;
      const question = state.questions[state.index];
      state.locked = false;
      state.questionSeconds = 30;
      el.questionCount.textContent = `Thử thách ${state.index + 1} / ${zones.length}`;
      el.mathQuestion.textContent = `${question.expression} = ?`;
      el.answerHint.textContent = "";
      el.questionTimer.textContent = "⏳ 30 giây";
      el.questionTimer.classList.remove("urgent");
      el.answersGrid.innerHTML = "";

      question.options.forEach((option, optionIndex) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "answer-button";
        button.textContent = `${String.fromCharCode(65 + optionIndex)}. ${option}`;
        button.setAttribute("aria-label", `Đáp án ${String.fromCharCode(65 + optionIndex)}: ${option}`);
        button.addEventListener("click", () => selectAnswer(option, button));
        el.answersGrid.appendChild(button);
      });

      el.questionLayer.classList.add("show");
      startQuestionTimer();
      playTone("chest");
    }

    function startQuestionTimer() {
      clearInterval(state.questionTimer);
      state.questionTimer = setInterval(() => {
        if (!state.running || state.paused || state.locked) return;
        state.questionSeconds -= 1;
        el.questionTimer.textContent = `⏳ ${state.questionSeconds} giây`;
        if (state.questionSeconds <= 8) el.questionTimer.classList.add("urgent");
        if (state.questionSeconds <= 0) {
          clearInterval(state.questionTimer);
          handleTimeout();
        }
      }, 1000);
    }

    function handleTimeout() {
      if (state.locked) return;
      const correctAnswer = state.questions[state.index].answer;
      const correctButton = [...el.answersGrid.querySelectorAll("button")]
        .find(button => button.textContent.endsWith(String(correctAnswer)));
      settleAnswer(false, null, correctButton, true);
    }

    function coinsBurst() {
      const originX = window.innerWidth / 2;
      const originY = window.innerHeight / 2;

      for (let i = 0; i < 15; i += 1) {
        const particle = document.createElement("span");
        particle.className = "coin";
        particle.textContent = i % 4 === 0 ? "💎" : "🪙";
        particle.style.left = `${originX + (Math.random() * 42 - 21)}px`;
        particle.style.top = `${originY + 25}px`;
        particle.style.setProperty("--x", `${Math.random() * 300 - 150}px`);
        particle.style.setProperty("--y", `${Math.random() * -190 - 70}px`);
        document.body.appendChild(particle);
        setTimeout(() => particle.remove(), 1000);
      }
    }

    function sparkleBurst() {
      const originX = window.innerWidth / 2;
      const originY = window.innerHeight / 2;
      for (let i = 0; i < 15; i += 1) {
        const particle = document.createElement("span");
        particle.className = "sparkle";
        particle.textContent = "✨";
        particle.style.left = `${originX}px`;
        particle.style.top = `${originY}px`;
        particle.style.setProperty("--x", `${Math.random() * 320 - 160}px`);
        particle.style.setProperty("--y", `${Math.random() * -210 - 65}px`);
        document.body.appendChild(particle);
        setTimeout(() => particle.remove(), 900);
      }
    }

    function selectAnswer(choice, selectedButton) {
      if (state.locked) return;
      const question = state.questions[state.index];
      const buttons = [...el.answersGrid.querySelectorAll("button")];
      const correctButton = buttons.find(button => button.textContent.endsWith(String(question.answer)));
      settleAnswer(choice === question.answer, selectedButton, correctButton, false);
    }

    function settleAnswer(isCorrect, selectedButton, correctButton, timedOut) {
      if (state.locked) return;
      state.locked = true;
      clearInterval(state.questionTimer);
      [...el.answersGrid.querySelectorAll("button")].forEach(button => { button.disabled = true; });

      if (isCorrect) {
        selectedButton.classList.add("correct");
        state.score += 100;
        state.coins += 10;
        state.correct += 1;
        el.answerHint.textContent = "✅ Chính xác! Hải tặc nhí đang chạy tới!";
        el.answerHint.style.color = "#23834a";
        el.pirate.classList.remove("sad");
        el.pirate.classList.add("happy");
        coinsBurst();
        sparkleBurst();
        playTone("correct");
        setTimeout(() => playTone("coin"), 120);
        if (state.correct > 0 && state.correct % 5 === 0) {
          setTimeout(() => showStatus("🌟 Giỏi lắm! Em là hải tặc thông minh!"), 300);
        }
      } else {
        if (selectedButton) selectedButton.classList.add("wrong");
        if (correctButton) correctButton.classList.add("correct");
        state.hearts = Math.max(0, state.hearts - 1);
        el.answerHint.textContent = timedOut
          ? `⏳ Hết giờ! Đáp án đúng là ${state.questions[state.index].answer}.`
          : `❌ Chưa đúng! Đáp án đúng là ${state.questions[state.index].answer}.`;
        el.answerHint.style.color = "#c14342";
        el.adventureScreen.classList.add("shake");
        el.pirate.classList.remove("happy");
        el.pirate.classList.add("sad");
        playTone("wrong");
        setTimeout(() => el.adventureScreen.classList.remove("shake"), 520);
      }

      updateHud();

      setTimeout(() => {
        el.questionLayer.classList.remove("show");
        if (state.finalChallenge) {
          if (isCorrect) {
            showStatus("🧠 Thần Đồng Toán Học đã mở kho báu!");
            finishGame(true);
          } else {
            state.finalChallenge = false;
            openTreasure();
          }
          return;
        }
        if (state.hearts <= 0) {
          finishGame(false);
          return;
        }
        advanceScene(isCorrect);
      }, isCorrect ? 1450 : 2250);
    }

    function advanceScene(isCorrect) {
      if (isCorrect) {
        const target = parseFloat(zones[state.index].checkpoint) - 6;
        el.pirate.classList.remove("happy");
        el.pirate.classList.add("running");
        el.pirate.style.left = `${target}%`;
      }

      setTimeout(() => {
        el.pirate.classList.remove("running", "sad");
        state.index += 1;
        updateHud();

        if (state.index >= zones.length) {
          openTreasure();
          return;
        }

        el.adventureScreen.classList.add("hidden");
        el.mapScreen.classList.remove("hidden");
        updateMap();
        showStatus(isCorrect ? "🪙 Tuyệt vời! Đến chặng tiếp theo nào!" : "⚓ Cố lên! Tàu vẫn tiếp tục hành trình!");
      }, isCorrect ? 800 : 260);
    }

    function openTreasure() {
      el.finishChest.classList.remove("hidden");
      el.checkpoint.classList.add("hidden");
      el.checkpointLabel.textContent = "Món quà kho báu đang chờ bạn!";
      el.sceneTitle.textContent = "Đảo kho báu huyền thoại";
      el.sceneCopy.textContent = "Bạn đã vượt qua mọi chặng. Mở rương vàng nào!";
      el.sceneWorld.style.transform = "translateX(-130%)";
      document.getElementById("island-6").classList.remove("locked", "active");
      document.getElementById("island-6").classList.add("completed");
      document.querySelector("#island-6 .island-state").textContent = "✔";
      showStatus("💎 Kho báu huyền thoại đã xuất hiện!");
    }

    function getStars() {
      if (state.correct >= 6) return 3;
      if (state.correct >= 4) return 2;
      if (state.correct >= 2) return 1;
      return 0;
    }

    function launchConfetti() {
      const colors = ["#ff6b5d", "#ffd64a", "#44cf93", "#6bcdf4", "#9a74f2", "#ffffff"];
      for (let i = 0; i < 78; i += 1) {
        const piece = document.createElement("span");
        piece.className = "confetti";
        piece.style.left = `${Math.random() * 100}%`;
        piece.style.background = colors[i % colors.length];
        piece.style.setProperty("--x", `${Math.random() * 180 - 90}px`);
        piece.style.setProperty("--duration", `${1.8 + Math.random() * 1.5}s`);
        document.body.appendChild(piece);
        setTimeout(() => piece.remove(), 3600);
      }
    }

    function getLeaderboard() {
      try {
        const saved = JSON.parse(localStorage.getItem(leaderboardKey) || "[]");
        return Array.isArray(saved) ? saved : [];
      } catch {
        return [];
      }
    }

    function saveLeaderboardEntry() {
      const entries = getLeaderboard();
      entries.push({
        name: state.playerName,
        score: state.score,
        coins: state.coins,
        time: state.elapsed,
        createdAt: Date.now()
      });

      entries.sort((a, b) => b.score - a.score || b.coins - a.coins || a.time - b.time || a.createdAt - b.createdAt);

      try {
        localStorage.setItem(leaderboardKey, JSON.stringify(entries.slice(0, 10)));
      } catch {
        showStatus("Chưa thể lưu bảng xếp hạng trên thiết bị này.");
      }
    }

    function renderLeaderboard() {
      const entries = getLeaderboard()
        .sort((a, b) => b.score - a.score || b.coins - a.coins || a.time - b.time || a.createdAt - b.createdAt)
        .slice(0, 10);

      el.leaderboardContent.innerHTML = "";

      if (!entries.length) {
        const empty = document.createElement("p");
        empty.className = "leaderboard-empty";
        empty.textContent = "Chưa có thuyền trưởng nào trên bảng xếp hạng. Hãy là người đầu tiên!";
        el.leaderboardContent.appendChild(empty);
        return;
      }

      const wrapper = document.createElement("div");
      wrapper.className = "leaderboard-wrap";

      const table = document.createElement("table");
      table.className = "leaderboard-table";
      table.innerHTML = `
        <thead>
          <tr>
            <th>🏅 Hạng</th>
            <th>👤 Tên</th>
            <th>⭐ Điểm</th>
            <th>🪙 Xu</th>
            <th>⏱ Thời gian</th>
          </tr>
        </thead>
      `;

      const tbody = document.createElement("tbody");
      entries.forEach((entry, index) => {
        const row = document.createElement("tr");
        [index + 1, entry.name, entry.score, entry.coins, formatTime(entry.time)].forEach(value => {
          const cell = document.createElement("td");
          cell.textContent = String(value);
          row.appendChild(cell);
        });
        tbody.appendChild(row);
      });

      table.appendChild(tbody);
      wrapper.appendChild(table);
      el.leaderboardContent.appendChild(wrapper);
    }

    function openLeaderboard() {
      renderLeaderboard();
      el.leaderboardLayer.classList.add("show");
      playTone("click");
    }

    function finishGame(victory) {
      state.running = false;
      clearInterval(state.gameTimer);
      clearInterval(state.questionTimer);
      stopBackgroundMusic();
      el.questionLayer.classList.remove("show");
      el.pauseLayer.classList.remove("show");
      el.adventureScreen.classList.add("hidden");

      el.finalScore.textContent = state.score;
      el.finalCorrect.textContent = `${state.correct}/${zones.length}`;
      el.finalCoins.textContent = state.coins;
      el.finalTime.textContent = formatTime(state.elapsed);

      const stars = getStars();
      el.starRow.textContent = "★".repeat(stars) + "☆".repeat(3 - stars);

      if (victory) {
        el.resultEmoji.textContent = "🏆";
        el.resultMessage.textContent = `🎉 Chúc mừng ${state.playerName}! Bạn đã tìm thấy kho báu toán học huyền thoại!`;
        launchConfetti();
        coinsBurst();
        sparkleBurst();
        playTone("win");
      } else {
        el.resultEmoji.textContent = "🧭";
        el.resultMessage.textContent = `Hải tặc ${state.playerName} cần thêm năng lượng. Hãy chơi lại để chinh phục kho báu nhé!`;
        playTone("wrong");
      }

      saveLeaderboardEntry();
      el.resultLayer.classList.add("show");
    }

    function startGame() {
      const name = el.playerName.value.trim();
      if (!name) {
        showStatus("⚓ Hãy nhập tên thuyền trưởng trước khi ra khơi!");
        el.playerName.focus();
        return;
      }

      initAudio();
      state.playerName = name;
      state.questions = generateQuestions();
      state.index = 0;
      state.score = 0;
      state.coins = 0;
      state.hearts = 3;
      state.correct = 0;
      state.elapsed = 0;
      state.running = true;
      state.paused = false;
      state.locked = false;
      state.finalChallenge = false;

      el.startScreen.classList.add("hidden");
      el.resultLayer.classList.remove("show");
      el.mapScreen.classList.remove("hidden");
      updateHud();
      updateMap();
      startGameTimer();
      playBackgroundMusic();
      playTone("click");
      showStatus(`⚓ Thuyền trưởng ${state.playerName} đã sẵn sàng ra khơi!`);
    }

    function returnHome() {
      clearInterval(state.gameTimer);
      clearInterval(state.questionTimer);
      state.running = false;
      state.paused = false;
      state.locked = false;
      el.questionLayer.classList.remove("show");
      el.pauseLayer.classList.remove("show");
      el.resultLayer.classList.remove("show");
      el.adventureScreen.classList.add("hidden");
      el.mapScreen.classList.add("hidden");
      el.startScreen.classList.remove("hidden");
      updateHud();
      playTone("click");
    }

    function pauseGame() {
      if (!state.running || el.questionLayer.classList.contains("show")) return;
      state.paused = true;
      el.pauseLayer.classList.add("show");
      playTone("click");
    }

    function resumeGame() {
      state.paused = false;
      el.pauseLayer.classList.remove("show");
      playTone("click");
    }

    el.startButton.addEventListener("click", startGame);
    el.playerName.addEventListener("keydown", event => {
      if (event.key === "Enter") startGame();
    });
    el.sailButton.addEventListener("click", sailToZone);
    el.checkpoint.addEventListener("click", openQuestion);

    el.finishChest.addEventListener("click", () => {
      if (!state.running || state.index < zones.length) return;
      state.finalChallenge = true;
      state.questions.push(makeQuestion(new Set(state.questions.map(question => question.expression))));
      el.finishChest.classList.add("opening");
      el.pirate.classList.add("victory");
      coinsBurst();
      sparkleBurst();
      setTimeout(() => {
        el.finishChest.classList.add("hidden");
        el.finishChest.classList.remove("opening");
        playTone("chest");
        openQuestion();
      }, 720);
    });

    el.pauseButton.addEventListener("click", pauseGame);
    el.resumeButton.addEventListener("click", resumeGame);
    el.homeButton.addEventListener("click", returnHome);
    el.soundButton.addEventListener("click", toggleSound);

    el.guideButton.addEventListener("click", () => {
      el.infoLayer.classList.add("show");
      playTone("click");
    });

    el.closeGuideButton.addEventListener("click", () => {
      el.infoLayer.classList.remove("show");
      playTone("click");
    });

    el.leaderboardButton.addEventListener("click", openLeaderboard);
    el.resultLeaderboardButton.addEventListener("click", openLeaderboard);

    el.closeLeaderboardButton.addEventListener("click", () => {
      el.leaderboardLayer.classList.remove("show");
      playTone("click");
    });

    el.playAgainButton.addEventListener("click", () => {
      el.resultLayer.classList.remove("show");
      startGame();
    });

    document.addEventListener("keydown", event => {
      if (event.key !== "Escape") return;
      if (el.infoLayer.classList.contains("show")) {
        el.infoLayer.classList.remove("show");
      } else if (el.leaderboardLayer.classList.contains("show")) {
        el.leaderboardLayer.classList.remove("show");
      } else if (state.running && !el.questionLayer.classList.contains("show")) {
        state.paused ? resumeGame() : pauseGame();
      }
    });

    updateHud();
    lucide.createIcons();
  </script>
 </body>
</html>
